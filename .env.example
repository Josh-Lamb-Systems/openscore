# Public base URL of this instance (used in links, result URLs and webhook payloads)
APP_URL=http://localhost:5173

# Postgres connection string (compose overrides this for the app containers)
DATABASE_URL=postgres://openscore:openscore@localhost:54329/openscore

# Random secret used to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# SMTP for invites, password resets and magic links.
# If SMTP_HOST is empty, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OpenScore <no-reply@example.com>"

# Run database migrations when the web server starts (default true)
RUN_MIGRATIONS=true
