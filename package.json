{
  "name": "openscore",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:worker": "tsx watch worker/index.ts",
    "build": "react-router build && npm run build:node",
    "build:node": "esbuild worker/index.ts scripts/migrate.ts scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=build/node --tsconfig=tsconfig.json",
    "start": "node build/node/scripts/migrate.js && react-router-serve ./build/server/index.js",
    "worker": "node build/node/worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts --force",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.63.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24"
  }
}
